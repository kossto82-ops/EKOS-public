# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Optional fallback key for Groq AI API inference providers.
GROQ_API_KEY=

# ENCRYPTION_SECRET: Used as the secret key for AES-256 encryption of stored API keys in the database.
# Must be a unique, cryptographically strong secret in production to ensure raw keys cannot be decrypted if the database is exposed.
ENCRYPTION_SECRET=

# ---------------------------------------------------------------------------
# Corporate authentication (OAuth2 introspection) — OPTIONAL.
# Leave AUTH_CLIENT_ID/SECRET unset to run in the interim "legacy" mode, where
# the Bearer token is an unsigned user id (local dev / demo / pre-IdP). Set a
# dedicated `ekos` client credential pair (NOT the `cline` MCP client) to switch
# the backend to validating opaque corporate tokens by introspection. Defaults
# to the Test environment. See docs/AUTH_INTEGRATION_PLAN.md.
# ---------------------------------------------------------------------------
# AUTH_MODE: force "oauth" even without client creds (rarely needed — presence of
# AUTH_CLIENT_ID + AUTH_CLIENT_SECRET already switches modes). Unset = auto.
AUTH_MODE=
# AUTH_BASE_URL: authorization server base. Default (Test):
# https://rest.tsrv.northwind.internal/authorization/v1 — Live is
# https://rest.northwind.internal/authorization/v1
AUTH_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# AUTH_INTROSPECTION_TTL_MS / AUTH_REQUEST_TIMEOUT_MS: cache lifetime for an
# introspection result and per-call upstream timeout. Defaults: 60000 / 5000.
AUTH_INTROSPECTION_TTL_MS=
AUTH_REQUEST_TIMEOUT_MS=
# BFF login flow (used only in oauth mode). AUTH_CALLBACK_URL is the redirect_uri
# registered with the auth server; defaults to <ALLOWED_ORIGIN>/auth/callback.
# AUTH_POST_LOGIN_REDIRECT is where the browser lands after login (default
# <ALLOWED_ORIGIN>/). AUTH_SCOPES defaults to "read write".
AUTH_CALLBACK_URL=
AUTH_POST_LOGIN_REDIRECT=
AUTH_SCOPES=
# Session cookie (BFF). SESSION_COOKIE_SECRET signs the httpOnly session id
# (falls back to ENCRYPTION_SECRET if unset). SESSION_TTL_HOURS is the absolute
# session lifetime (default 8, per docs/SECURITY.md §1). SESSION_IDLE_MINUTES is
# the inactivity timeout — a session with no authenticated request for this long
# is killed server-side (default 30; 0 disables). SESSION_COOKIE_NAME defaults to
# ekos_session.
SESSION_COOKIE_SECRET=
SESSION_TTL_HOURS=
SESSION_IDLE_MINUTES=
SESSION_COOKIE_NAME=

# ---------------------------------------------------------------------------
# Live SharePoint Knowledge Base sync (Microsoft Graph) — OPTIONAL.
# Leave these unset to run on the ingested snapshot (src/data/sharepoint-kb-snapshot.json).
# When all five are set, POST /api/db/sync/sharepoint and `npm run ingest:sharepoint`
# crawl the library directly via Graph. See docs/SHAREPOINT_SYNC.md.
# The Azure AD app registration needs application permission Sites.Read.All (admin-consented).
# ---------------------------------------------------------------------------
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER_ID=
# Optional: comma-separated top-level folder names to skip (default "99 - Archive").
SP_EXCLUDE_FOLDERS=
# Optional: label recorded in the snapshot's source.libraryPath.
SP_LIBRARY_PATH=


# ---------------------------------------------------------------------------
# Deployment. Set by deploy/docker-compose.yml; listed here because a bare
# `npm start` on a VM needs them too.
# ---------------------------------------------------------------------------

# DATABASE_PATH: where the SQLite file lives. Unset, it is db.sqlite in the
# working directory — fine for local development, wrong in a container, where the
# data must be on a mounted volume and the code is not. Getting this wrong fails
# SILENTLY: the schema self-bootstraps, seeding runs, and the service comes up
# healthy and empty. See deploy/README.md.
DATABASE_PATH=

# DRIZZLE_MIGRATIONS_DIR: where the .sql migration files are at runtime. The
# production bundle (dist/server.cjs) cannot embed them, so a container copies
# them separately and points this at them.
DRIZZLE_MIGRATIONS_DIR=

# ALLOWED_ORIGIN: the browser-facing origin. Defaults to http://localhost:3000.
# If it does not match, CORS rejects the SPA's own API calls — the UI loads and
# then does nothing.
ALLOWED_ORIGIN=

# VITE_AUTH_MODE: FRONTEND build-time flag (Vite). Leave unset/'legacy' for the
# impersonation demo. Set to 'oauth' — alongside the backend AUTH_* config above —
# to make the SPA hydrate its identity from GET /auth/me, send no Bearer id, and
# redirect to /auth/login on a 401. See docs/AUTH_INTEGRATION_PLAN.md §2c.
VITE_AUTH_MODE=

# ---------------------------------------------------------------------------
# Backups. Consumed by the `backup` service in deploy/docker-compose.yml
# (deploy/backup.cjs), which runs by default — not gated behind the
# `observability` profile — because the single volume it protects is the only
# copy of the corpus. See deploy/README.md before assuming this is finished.
# ---------------------------------------------------------------------------

# BACKUP_INTERVAL_SECONDS / BACKUP_RETENTION_COUNT: how often an online backup is
# taken and how many gzipped copies are kept. Defaults: every 6 hours, keep 28
# (~1 week).
BACKUP_INTERVAL_SECONDS=
BACKUP_RETENTION_COUNT=

# BACKUP_OFFHOST_URL: a URL this process can HTTP PUT a backup to — an
# S3-compatible presigned URL, an Azure Blob SAS URL, a GCS signed URL, or a
# receiver you run yourself. Left unset, backups are written only to the
# `ekos-backups` named volume, which is on the SAME HOST as `ekos-data` — a
# second volume on one VM is not an off-host backup, and shares that VM's fate.
#
# ENCRYPTION_SECRET above and the database it encrypts keys in are one backup
# unit: back up this file (or at minimum that one variable) separately, and keep
# it with wherever the database backups end up. This script does not do that for
# you — see deploy/backup.cjs.
BACKUP_OFFHOST_URL=

# ---------------------------------------------------------------------------
# Alerting destination. NOT an environment variable: Alertmanager does not
# expand env vars in its config, and the flag that was supposed to make it do so
# does not exist (it exited at startup on the unknown flag until this was
# corrected). A real destination is configured with `url_file` — write the URL
# to a file, mount it into the alertmanager container, and point the
# `operator-webhook` receiver in deploy/alertmanager.yml at that path. The
# route's receiver must be repointed too; it is commented out by design.
#
# Leave it alone and alerts go only to the local log sink (deploy/alert-sink.js),
# which notifies no one — see deploy/README.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Telemetry (OpenTelemetry). All optional: with OTEL_EXPORTER_OTLP_ENDPOINT
# unset, the SDK never starts — no exporters, no timers, no connection attempts.
# That is the intended state for local development. See docs/OPERATIONS.md.
# ---------------------------------------------------------------------------

# OTEL_EXPORTER_OTLP_ENDPOINT: base URL of an OTLP/HTTP collector. The app appends
# /v1/traces, /v1/metrics and /v1/logs. Compose sets this to the bundled collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTEL_SERVICE_NAME: service.name on every span, metric and log. Default ekos-api.
OTEL_SERVICE_NAME=

# EKOS_VERSION: service.version. CI stamps the commit sha into the image so
# telemetry can be filtered by release instead of correlated against a deploy log.
EKOS_VERSION=

# OTEL_SDK_DISABLED: set to "true" to switch telemetry off without unsetting the
# endpoint above.
OTEL_SDK_DISABLED=

# LOG_LEVEL: overrides the default (info in production, debug in development,
# silent under test).
LOG_LEVEL=
